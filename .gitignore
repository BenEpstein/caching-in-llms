research/
.hyperresearch/
benchmarks/workloads/*.jsonl
# The novel-profile replays live one level down and regenerate the same way.
benchmarks/workloads/novel/*.jsonl
# results/ is tracked (raw CSVs + prom JSON) so runs are reviewable without rerunning.
# Frozen workload jsonl stays out - reproduce it from benchmarks/workloads/manifest.json.
results/**/*.jsonl
# The raw Job log (#27) is the TRANSPORT for the driver CSVs, not a result: ~2.4 MB of
# base64 per cell that decodes to the driver-seed*.csv already tracked beside it. Kept on
# disk for debugging, out of git.
results/**/job.log
# Session handoffs are working notes, not submission artifacts: rationale lives in GitHub
# issues and docs/ holds artifacts only. Six tracked handoffs were removed 2026-08-05
# (issue #29); they survive in git history.
docs/handoffs/
docs/handoff-*.md
.DS_Store
# Agent scaffolding (#61): documentation of how the project was built, not of the project.
# Anchored to the repo root so an upstream file of the same name under patches/ stays
# trackable. Recover the last tracked state of one, whatever the merge strategy was:
#   git show "$(git rev-list -1 HEAD -- CHANGELOG.md)^:CHANGELOG.md"
/CLAUDE.md
/CONTEXT.md
/CHANGELOG.md
CLAUDE.local.md
# Agent session worktrees are nested git checkouts, hundreds of MB. Already invisible to a
# clone (nothing here is tracked), but only THIS clone ignores them, via .git/info/exclude -
# which never travels. Without this line a second collaborator's `git add -A` tries to commit
# them. Deliberately narrow: `.claude/` itself stays trackable in case shared project config
# ever lands there.
.claude/worktrees/
__pycache__/
# Both READMEs tell the reader to `python3 -m venv .venv` at the repo root, so every
# person who follows the setup guide creates this.
.venv/
.hypothesis/
.pytest_cache/
teaching/

# reproduce.sh's FIGS_OUT target. The committed sets under docs/figures*/ are the artifact.
ci-figures/
